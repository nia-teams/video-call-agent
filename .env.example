# 从项目根目录执行：cp .env.example .env
# 所有应用配置只从 .env 读取；修改后重启。不要提交真实密钥。
# 不执行 shell 表达式或 ${变量} 插值；含 # 的值请加引号。

# 本机服务端口：1024..65535，启动器、网页和 OBS 输出地址共用。
PORT=3070
# 自动接听、自动采集：仅接受 1（开启）或 0（关闭）。
STUDIO_AUTO_ANSWER=1
STUDIO_AUTO_CAPTURE=1

# OBS：一键启动及 obs:* 命令必填；仅使用媒体控制台时可同时留空。
# 地址例如 ws://127.0.0.1:4455；密码填写 OBS WebSocket 的认证密码。
# OBS 未运行时，启动器会按这两个值配置 OBS；运行中需确保设置一致。
OBS_WEBSOCKET_URL=
OBS_WEBSOCKET_PASSWORD=

# Qwen：不使用时 Key 和 URL 同时留空；使用时必须成对填写。
DASHSCOPE_API_KEY=
# 使用获授权的 wss:// 端点，例如 wss://dashscope.aliyuncs.com/api-ws/v1/realtime。
QWEN_REALTIME_URL=
# 留空时采用 URL 的 model，URL 未指定时默认 qwen3.5-omni-flash-realtime；两处填写时必须一致。
QWEN_REALTIME_MODEL=
QWEN_VOICE=Raymond
# 可选服务端提示词，留空使用默认行为；多行内容用双引号包围。
QWEN_INSTRUCTIONS=

# Live Canvas：无 Key 演示可留空；真实语音需要 OPENAI_API_KEY。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LIVE_MODEL=gpt-live-1
# 后端 Key 留空时复用 OPENAI_API_KEY。
OPENAI_BACKEND_API_KEY=
OPENAI_BACKEND_BASE_URL=https://api.openai.com/v1
OPENAI_BACKEND_MODEL=gpt-4.1
